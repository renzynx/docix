{
	"$schema": "https://json.schemastore.org/tsconfig",
	"extends": "./base.json",
	"compilerOptions": {
		"lib": ["dom", "dom.iterable", "ES2022"],
		"jsx": "react-jsx",
		"plugins": [{ "name": "next" }],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"allowJs": true,
		"incremental": true,
		"declaration": false,
		"declarationMap": false
	}
}
