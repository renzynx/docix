{
	"$schema": "https://turborepo.com/schema.json",
	"ui": "tui",
	"globalPassThroughEnv": [
		"CI",
		"VERCEL",
		"NODE_ENV",
		"HOST",
		"SERVER_PORT",
		"GO_ENV",
		"AUTH_SECRET",
		"TRUSTED_ORIGINS",
		"MONGO_URL",
		"REDIS_HOST",
		"REDIS_PORT",
		"REDIS_URL",
		"REDIS_PASSWORD",
		"REDIS_DB",
		"REDIS_POOL_SIZE",
		"UPLOAD_DIR",
		"PENDING_UPLOAD_DIR",
		"UPLOAD_MAX_SIZE",
		"UPLOAD_BASE_URL",
		"WEBP_QUALITY",
		"CDN_PORT",
		"CDN_BASE_URL",
		"HMAC_SECRET",
		"URL_TTL_SECS",
		"CDN_URL_TTL_SECS",
		"WORKER_CONCURRENCY",
		"SMTP_HOST",
		"SMTP_PORT",
		"SMTP_USERNAME",
		"SMTP_PASSWORD",
		"SMTP_FROM",
		"SMTP_USE_TLS",
		"NEXT_PUBLIC_API_URL"
	],
	"globalDependencies": ["tsconfig.json"],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": [".next/**", "!.next/cache/**", "dist/**"],
			"cache": true
		},
		"dev": {
			"cache": false,
			"persistent": true,
			"interruptible": true
		},
		"lint": {
			"dependsOn": ["^build"],
			"cache": true
		},
		"type-check": {
			"dependsOn": ["^build"],
			"cache": true
		},
		"clean": {
			"cache": false
		},
		"generate": {
			"cache": false
		},
		"generate:types": {
			"cache": false
		}
	}
}
