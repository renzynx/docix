{
	"$schema": "https://json.schemastore.org/tsconfig",
	"extends": "@docix/typescript-config/nextjs.json",
	"compilerOptions": {
		"paths": {
			"@/*": ["./src/*"]
		}
	},
	"include": [
		"next-env.d.ts",
		"**/*.ts",
		"**/*.tsx",
		"**/*.mts",
		".next/types/**/*.ts"
	],
	"exclude": ["node_modules"]
}
