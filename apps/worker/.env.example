# Worker Configuration
DEBUG=false

# Redis (for queue and status updates)
# Option 1: Full URL (takes precedence)
# REDIS_URL=redis://localhost:6379/0
# Option 2: Individual settings
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# MongoDB (required for cleanup tasks)
MONGO_URL=mongodb://localhost:27017/docix

# Worker Settings
WORKER_CONCURRENCY=10

# Upload Directories (must match server's upload directories)
UPLOAD_DIR=../server/uploads
PENDING_UPLOAD_DIR=../server/uploads/pending

# Image Processing
WEBP_QUALITY=85
MAX_FILE_SIZE=52428800
