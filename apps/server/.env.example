# Server Configuration
HOST=localhost
PORT=8000
GO_ENV=development

# Security
AUTH_SECRET=your-secret-key-here
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=docix

# Upload Configuration
UPLOAD_DIR=./uploads
UPLOAD_MAX_SIZE=10485760

# CDN Configuration (for generating signed URLs)
CDN_BASE_URL=http://localhost:8081
HMAC_SECRET=change-me-in-production
CDN_URL_TTL_SECS=86400

# SMTP (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=false
